<section class="gx-why" style="--gx-why-bg: {{ section.settings.background_color }}; --gx-why-accent: {{ section.settings.accent_color }};">
  <div class="gx-why__wrap">
    <div class="gx-why__hero">
      <div class="gx-why__hero-copy">
        {% if section.settings.eyebrow != blank %}<p class="gx-why__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h1>{{ section.settings.heading | escape }}</h1>
        {% if section.settings.intro != blank %}<div class="gx-why__intro">{{ section.settings.intro }}</div>{% endif %}
      </div>
      <div class="gx-why__hero-media">
        {% if section.settings.hero_video != blank %}
          {{ section.settings.hero_video | video_tag: class: 'gx-why__media', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
        {% elsif section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1800 | image_tag: class: 'gx-why__media', loading: 'eager', widths: '640, 900, 1200, 1800', sizes: '(min-width: 990px) 48vw, 100vw', alt: section.settings.hero_alt }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'gx-why__media gx-why__placeholder' }}
        {% endif %}
      </div>
    </div>

    <div class="gx-why__purpose">
      <p class="gx-why__eyebrow">{{ section.settings.purpose_eyebrow | escape }}</p>
      <h2>{{ section.settings.purpose_heading | escape }}</h2>
      <div class="gx-why__richtext">{{ section.settings.purpose_body }}</div>
    </div>

    <div class="gx-why__story">
      <div class="gx-why__section-head">
        <p class="gx-why__eyebrow">{{ section.settings.story_eyebrow | escape }}</p>
        <h2>{{ section.settings.story_heading | escape }}</h2>
      </div>
      <div class="gx-why__timeline">
        {% for block in section.blocks %}
          {% if block.type == 'milestone' %}
            <article class="gx-why__milestone" {{ block.shopify_attributes }}>
              <div class="gx-why__milestone-copy">
                {% if block.settings.label != blank %}<p class="gx-why__label">{{ block.settings.label | escape }}</p>{% endif %}
                <h3>{{ block.settings.title | escape }}</h3>
                <div class="gx-why__richtext">{{ block.settings.body }}</div>
              </div>
              {% if block.settings.video != blank or block.settings.image != blank %}
                <div class="gx-why__milestone-media">
                  {% if block.settings.video != blank %}
                    {{ block.settings.video | video_tag: class: 'gx-why__media', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
                  {% else %}
                    {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'gx-why__media', loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 42vw, 100vw', alt: block.settings.image_alt }}
                  {% endif %}
                </div>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="gx-why__principles">
      <div class="gx-why__section-head">
        <p class="gx-why__eyebrow">{{ section.settings.principles_eyebrow | escape }}</p>
        <h2>{{ section.settings.principles_heading | escape }}</h2>
      </div>
      <div class="gx-why__principle-grid">
        {% assign principle_number = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'principle' %}
            {% assign principle_number = principle_number | plus: 1 %}
            <article class="gx-why__principle" {{ block.shopify_attributes }}>
              <span>{{ principle_number | prepend: '0' | slice: -2, 2 }}</span>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ block.settings.body | escape }}</p>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="gx-why__promise">
      <div>
        <p class="gx-why__eyebrow">{{ section.settings.promise_eyebrow | escape }}</p>
        <h2>{{ section.settings.promise_heading | escape }}</h2>
      </div>
      <div class="gx-why__richtext">{{ section.settings.promise_body }}</div>
    </div>

    <div class="gx-why__cta">
      <p class="gx-why__eyebrow">{{ section.settings.cta_eyebrow | escape }}</p>
      <h2>{{ section.settings.cta_heading | escape }}</h2>
      {% if section.settings.cta_body != blank %}<div class="gx-why__richtext">{{ section.settings.cta_body }}</div>{% endif %}
      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}<a href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>{% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .gx-why { background: var(--gx-why-bg); color: #17161c; }
  .gx-why__wrap { width: min(100%, 1600px); margin: 0 auto; padding: clamp(40px, 6vw, 96px) clamp(20px, 5vw, 80px) clamp(80px, 10vw, 160px); }
  .gx-why__hero { display: grid; grid-template-columns: minmax(0, .88fr) minmax(0, 1.12fr); gap: clamp(36px, 7vw, 112px); align-items: center; min-height: min(760px, 82vh); }
  .gx-why__hero-copy h1 { margin: 14px 0 24px; max-width: 780px; font-size: clamp(50px, 7vw, 104px); font-weight: 400; line-height: .96; letter-spacing: -.055em; }
  .gx-why__eyebrow, .gx-why__label { margin: 0; color: #5f5d69; font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .gx-why__intro, .gx-why__richtext { color: #5f5d69; font-size: clamp(17px, 1.5vw, 21px); line-height: 1.62; }
  .gx-why__intro p, .gx-why__richtext p { margin: 0 0 1em; }
  .gx-why__hero-media { display: grid; min-height: 620px; overflow: hidden; border-radius: 36px; background: #f3f1f6; }
  .gx-why__media { display: block; width: 100%; height: 100%; min-height: 0; object-fit: cover; }
  .gx-why__placeholder { min-height: 620px; }
  .gx-why__purpose { display: grid; grid-template-columns: .5fr 1fr; gap: 40px; margin: clamp(100px, 14vw, 220px) 0; padding: clamp(48px, 7vw, 96px); border-radius: 36px; background: color-mix(in srgb, var(--gx-why-accent) 16%, white); }
  .gx-why__purpose h2, .gx-why__section-head h2, .gx-why__promise h2, .gx-why__cta h2 { margin: 12px 0 20px; font-size: clamp(38px, 5vw, 72px); font-weight: 400; line-height: 1.02; letter-spacing: -.045em; }
  .gx-why__section-head { max-width: 850px; margin-bottom: 56px; }
  .gx-why__timeline { display: grid; gap: 22px; }
  .gx-why__milestone { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(30px, 6vw, 96px); align-items: center; padding: clamp(32px, 5vw, 72px); border: 1px solid rgba(23,22,28,.12); border-radius: 32px; }
  .gx-why__milestone:nth-child(even) .gx-why__milestone-copy { order: 2; }
  .gx-why__milestone h3 { margin: 12px 0 18px; font-size: clamp(30px, 3vw, 46px); font-weight: 400; line-height: 1.05; letter-spacing: -.035em; }
  .gx-why__milestone-media { display: grid; min-height: 360px; overflow: hidden; border-radius: 24px; background: #f3f1f6; }
  .gx-why__principles { margin: clamp(100px, 14vw, 220px) 0; }
  .gx-why__principle-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
  .gx-why__principle { min-height: 320px; padding: clamp(28px, 4vw, 56px); border-radius: 28px; background: #f6f4f8; }
  .gx-why__principle span { color: var(--gx-why-accent); font-size: 14px; }
  .gx-why__principle h3 { margin: 70px 0 14px; font-size: clamp(27px, 3vw, 42px); font-weight: 400; letter-spacing: -.035em; }
  .gx-why__principle p { margin: 0; max-width: 540px; color: #5f5d69; font-size: 17px; line-height: 1.6; }
  .gx-why__promise { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 8vw, 120px); padding: clamp(48px, 7vw, 100px) 0; border-top: 1px solid rgba(23,22,28,.14); border-bottom: 1px solid rgba(23,22,28,.14); }
  .gx-why__cta { margin-top: clamp(100px, 14vw, 200px); padding: clamp(60px, 9vw, 130px); text-align: center; border-radius: 36px; background: #17161c; color: white; }
  .gx-why__cta .gx-why__eyebrow, .gx-why__cta .gx-why__richtext { color: rgba(255,255,255,.7); }
  .gx-why__cta .gx-why__richtext { max-width: 700px; margin: 0 auto; }
  .gx-why__cta a { display: inline-flex; margin-top: 28px; padding: 14px 26px; border-radius: 999px; background: white; color: #17161c; text-decoration: none; font-weight: 600; }
  @media (max-width: 989px) { .gx-why__hero, .gx-why__purpose, .gx-why__milestone, .gx-why__promise { grid-template-columns: 1fr; } .gx-why__hero { min-height: 0; } .gx-why__hero-media { min-height: 520px; } .gx-why__milestone:nth-child(even) .gx-why__milestone-copy { order: initial; } }
  @media (max-width: 749px) { .gx-why__wrap { padding-inline: 16px; } .gx-why__hero-media, .gx-why__placeholder { min-height: 430px; } .gx-why__purpose { padding: 34px 24px; } .gx-why__principle-grid { grid-template-columns: 1fr; } .gx-why__principle { min-height: 260px; } .gx-why__cta { padding: 56px 24px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Why Genesyx",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#6555c7" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Genesyx" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wellbeing guidance that starts with listening" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Genesyx brings cycle awareness, everyday tracking and gentle guidance into one calm, private space.</p>" },
    { "type": "video", "id": "hero_video", "label": "Hero video" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_alt", "label": "Hero image alt text", "default": "The Genesyx wellbeing experience" },
    { "type": "header", "content": "Purpose" },
    { "type": "text", "id": "purpose_eyebrow", "label": "Eyebrow", "default": "Why we exist" },
    { "type": "text", "id": "purpose_heading", "label": "Heading", "default": "Health information should feel useful, not overwhelming" },
    { "type": "richtext", "id": "purpose_body", "label": "Body", "default": "<p>Daily signals often live in different places and arrive without context. Genesyx is designed to bring the details you choose to track together, helping you notice patterns at your own pace.</p>" },
    { "type": "header", "content": "Story" },
    { "type": "text", "id": "story_eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "story_heading", "label": "Heading", "default": "Built around real everyday needs" },
    { "type": "header", "content": "Principles" },
    { "type": "text", "id": "principles_eyebrow", "label": "Eyebrow", "default": "What guides us" },
    { "type": "text", "id": "principles_heading", "label": "Heading", "default": "A more thoughtful relationship with your data" },
    { "type": "header", "content": "Promise" },
    { "type": "text", "id": "promise_eyebrow", "label": "Eyebrow", "default": "Our promise" },
    { "type": "text", "id": "promise_heading", "label": "Heading", "default": "Support without judgement" },
    { "type": "richtext", "id": "promise_body", "label": "Body", "default": "<p>Genesyx is an educational wellness tool. It does not diagnose or treat conditions. We aim to keep guidance clear, privacy-conscious and grounded in the information you choose to record.</p>" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_eyebrow", "label": "Eyebrow", "default": "Start your journey" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Meet Genesyx" },
    { "type": "richtext", "id": "cta_body", "label": "Body", "default": "<p>Explore a calmer way to understand your cycle and everyday wellbeing signals.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Explore the app" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "milestone", "name": "Story chapter", "settings": [
      { "type": "text", "id": "label", "label": "Chapter label" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "richtext", "id": "body", "label": "Body" },
      { "type": "video", "id": "video", "label": "Video" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_alt", "label": "Image alt text" }
    ] },
    { "type": "principle", "name": "Brand principle", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "body", "label": "Body" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Why Genesyx" }]
}
{% endschema %}
