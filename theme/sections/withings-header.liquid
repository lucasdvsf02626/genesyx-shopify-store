        { "type": "url", "id": "p3_link", "label": "3 · Link" },
        { "type": "image_picker", "id": "p3_pick", "label": "3 · Image (upload)" },
        { "type": "text", "id": "p3_img", "label": "3 · …or bundled filename" },
        { "type": "text", "id": "p3_tag", "label": "3 · Tag" },
        { "type": "text", "id": "p3_desc", "label": "3 · Description" },
