        { "type": "text", "id": "p5_name", "label": "5 · Name" },
        { "type": "url", "id": "p5_link", "label": "5 · Link" },
        { "type": "image_picker", "id": "p5_pick", "label": "5 · Image (upload)" },
        { "type": "text", "id": "p5_img", "label": "5 · …or bundled filename" },
        { "type": "text", "id": "p5_tag", "label": "5 · Tag" },
        { "type": "text", "id": "p5_desc", "label": "5 · Description" },
        { "type": "text", "id": "p6_name", "label": "6 · Name" },
        { "type": "url", "id": "p6_link", "label": "6 · Link" },
        { "type": "image_picker", "id": "p6_pick", "label": "6 · Image (upload)" },
        { "type": "text", "id": "p6_img", "label": "6 · …or bundled filename" },
