{%- comment -%} Withings U-Scan Nutrio header — sticky nav + hover mega-menu (static marketing markup) {%- endcomment -%}
<style>
  {%- comment -%} Dawn's base.css declares `.hidden { display: none !important }`, which beats Tailwind's
    `lg:flex` no matter the source order — that kept this nav hidden at every width. Scoping the
    responsive show/hide to its own class avoids the collision entirely. {%- endcomment -%}
  .wi-header .wi-nav { display: none; }
  @media (min-width: 64rem) { .wi-header .wi-nav { display: flex; } }
</style>
<header class="wi-scope wi-header sticky top-0 z-50 bg-white">
  <div class="wi-container flex h-16 items-center justify-between gap-6">
    {%- comment -%} Logo (CSS-mask wordmark, black) {%- endcomment -%}
    <a href="{{ routes.root_url }}" aria-label="{{ section.settings.logo_alt | default: shop.name | escape }}" class="shrink-0">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ section.settings.logo_alt | default: shop.name | escape }}" class="block w-auto" style="height:{{ section.settings.logo_height | default: 22 }}px">
      {%- else -%}
        <img src="{{ 'genesyx-logo.png' | asset_url }}" alt="{{ section.settings.logo_alt | default: shop.name | escape }}" class="block w-auto" style="height:{{ section.settings.logo_height | default: 22 }}px">
      {%- endif -%}
    </a>

    {%- comment -%} Primary nav {%- endcomment -%}
    <nav class="wi-nav items-center gap-7">
      {%- for item in section.blocks -%}
        {%- if item.type == 'nav_group' -%}
          <div class="wi-navitem group flex items-center" {{ item.shopify_attributes }}>
            <a href="{{ item.settings.link | default: '#' }}" class="flex items-center gap-1 text-[15px] text-ink transition-colors hover:text-ink/60">
              {{ item.settings.label }}
            </a>
            {%- comment -%} Mega panel {%- endcomment -%}
            <div class="wi-mega pointer-events-none absolute inset-x-0 top-16 origin-top border-t border-border-soft bg-white opacity-0 shadow-[0_24px_40px_-24px_rgba(0,0,0,0.25)] transition-all duration-200 group-hover:pointer-events-auto group-hover:opacity-100">
              <div class="wi-container grid grid-cols-2 gap-x-8 gap-y-6 py-8 md:grid-cols-4">
                {%- for i in (1..8) -%}
                  {%- assign name_key = 'p' | append: i | append: '_name' -%}
                  {%- assign img_key = 'p' | append: i | append: '_img' -%}
                  {%- assign pick_key = 'p' | append: i | append: '_pick' -%}
                  {%- assign tag_key = 'p' | append: i | append: '_tag' -%}
                  {%- assign desc_key = 'p' | append: i | append: '_desc' -%}
                  {%- assign link_key = 'p' | append: i | append: '_link' -%}
                  {%- assign p_name = item.settings[name_key] -%}
                  {%- assign p_img = item.settings[img_key] -%}
                  {%- assign p_pick = item.settings[pick_key] -%}
                  {%- assign p_tag = item.settings[tag_key] -%}
                  {%- assign p_desc = item.settings[desc_key] -%}
                  {%- assign p_link = item.settings[link_key] -%}
                  {%- if p_name != blank -%}
                    <a href="{{ p_link | default: '#' }}" class="group/card flex items-center gap-4 rounded-md p-2 transition-colors hover:bg-greige">
                      <span class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-md bg-greige">
                        {%- if p_pick != blank -%}
                          <img src="{{ p_pick | image_url: width: 128 }}" alt="{{ p_name }}" loading="lazy" class="h-full w-full object-contain">
                        {%- elsif p_img != blank -%}
                          <img src="{{ p_img | asset_url }}" alt="{{ p_name }}" width="64" height="64" loading="lazy" class="h-full w-full object-contain">
                        {%- endif -%}
                      </span>
                      <span class="min-w-0">
                        <span class="flex items-center gap-2">
                          <span class="text-[15px] font-medium text-ink">{{ p_name }}</span>
                          {%- if p_tag != blank -%}
                            <span class="rounded-full bg-[#eef1ff] px-2 py-0.5 text-[11px] font-medium text-periwinkle">{{ p_tag }}</span>
                          {%- endif -%}
                        </span>
                        {%- if p_desc != blank -%}
                          <span class="mt-1 block text-[13px] leading-snug text-ink-soft">{{ p_desc }}</span>
                        {%- endif -%}
                      </span>
                    </a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        {%- else -%}
          <div class="flex items-center" {{ item.shopify_attributes }}>
            <a href="{{ item.settings.link | default: '#' }}"
              class="flex items-center gap-1 text-[15px] transition-colors {% if item.settings.accent %}text-[#a97fd6]{% else %}text-ink hover:text-ink/60{% endif %}"
              {% if item.settings.external %}target="_blank" rel="noopener"{% endif %}>
              {{ item.settings.label }}
              {%- if item.settings.external -%}{% render 'wi-icon', name: 'arrow-up-right', class: 'h-3.5 w-3.5' %}{%- endif -%}
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    {%- comment -%} Account / cart {%- endcomment -%}
    <div class="flex shrink-0 items-center gap-4">
      <a href="{{ routes.account_url | default: '#' }}" aria-label="Account" class="text-ink hover:text-ink/60">
        {% render 'wi-icon', name: 'account', class: 'h-6 w-6' %}
      </a>
      <a href="{{ routes.cart_url }}" aria-label="Cart" class="text-ink hover:text-ink/60">
        {% render 'wi-icon', name: 'cart', class: 'h-6 w-6' %}
      </a>
    </div>
  </div>
</header>

{% schema %}
