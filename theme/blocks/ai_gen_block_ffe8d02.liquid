{% doc %}
  @prompt
    need to generate the menu of the front page , add the logo in the top left in the menu
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-nav-menu-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-nav-menu__wrapper-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
  }

  .ai-nav-menu__logo-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-nav-menu__logo-link-{{ ai_gen_id }} {
    display: block;
    line-height: 0;
  }

  .ai-nav-menu__logo-image-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: auto;
    display: block;
  }

  .ai-nav-menu__logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: 40px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-nav-menu__logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-nav-menu__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
    flex-wrap: wrap;
    flex-grow: 1;
    margin: 0;
    padding: 0;
  }

  .ai-nav-menu__item-{{ ai_gen_id }} {
    position: relative;
    list-style: none;
  }

  .ai-nav-menu__link-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.link_padding_vertical }}px {{ block.settings.link_padding_horizontal }}px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    transition: color 0.2s ease;
    border-radius: {{ block.settings.link_border_radius }}px;
  }

  .ai-nav-menu__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
    background-color: {{ block.settings.link_hover_bg }};
  }

  .ai-nav-menu__link-{{ ai_gen_id }}--active {
    color: {{ block.settings.active_link_color }};
    background-color: {{ block.settings.active_link_bg }};
  }

  @media screen and (max-width: 749px) {
    .ai-nav-menu__wrapper-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 20px;
    }

    .ai-nav-menu__logo-image-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_logo_width }}px;
    }

    .ai-nav-menu__logo-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_logo_width }}px;
    }

    .ai-nav-menu__container-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: {{ block.settings.mobile_alignment }};
      gap: {{ block.settings.mobile_item_spacing }}px;
    }

    .ai-nav-menu__link-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_font_size }}px;
    }
  }
{% endstyle %}

<nav-menu-{{ ai_gen_id }} class="ai-nav-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-nav-menu__wrapper-{{ ai_gen_id }}">
    <div class="ai-nav-menu__logo-{{ ai_gen_id }}">
      <a href="/" class="ai-nav-menu__logo-link-{{ ai_gen_id }}">
        {% if block.settings.logo %}
          <img
            src="{{ block.settings.logo | image_url: width: 400 }}"
            alt="{{ shop.name }}"
            class="ai-nav-menu__logo-image-{{ ai_gen_id }}"
            width="{{ block.settings.logo.width }}"
            height="{{ block.settings.logo.height }}"
            loading="lazy"
          >
        {% else %}
          <div class="ai-nav-menu__logo-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </a>
    </div>

    <ul class="ai-nav-menu__container-{{ ai_gen_id }}">
      {% if block.settings.menu != blank %}
        {% for link in block.settings.menu.links %}
          <li class="ai-nav-menu__item-{{ ai_gen_id }}">
            <a 
              href="{{ link.url }}" 
              class="ai-nav-menu__link-{{ ai_gen_id }} {% if link.active %}ai-nav-menu__link-{{ ai_gen_id }}--active{% endif %}"
              {% if link.current %}aria-current="page"{% endif %}
            >
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      {% else %}
        <li class="ai-nav-menu__item-{{ ai_gen_id }}">
          <a href="#" class="ai-nav-menu__link-{{ ai_gen_id }}">Home</a>
        </li>
        <li class="ai-nav-menu__item-{{ ai_gen_id }}">
          <a href="#" class="ai-nav-menu__link-{{ ai_gen_id }}">Shop</a>
        </li>
        <li class="ai-nav-menu__item-{{ ai_gen_id }}">
          <a href="#" class="ai-nav-menu__link-{{ ai_gen_id }}">About</a>
        </li>
        <li class="ai-nav-menu__item-{{ ai_gen_id }}">
          <a href="#" class="ai-nav-menu__link-{{ ai_gen_id }}">Contact</a>
        </li>
      {% endif %}
    </ul>
  </div>
</nav-menu-{{ ai_gen_id }}>

<script>
  (function() {
    class NavMenu{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.highlightCurrentPage();
      }

      highlightCurrentPage() {
        const currentPath = window.location.pathname;
        const links = this.querySelectorAll('.ai-nav-menu__link-{{ ai_gen_id }}');
        
        links.forEach(link => {
          if (link.getAttribute('href') === currentPath) {
            link.classList.add('ai-nav-menu__link-{{ ai_gen_id }}--active');
            link.setAttribute('aria-current', 'page');
          }
        });
      }
    }

    customElements.define('nav-menu-{{ ai_gen_id }}', NavMenu{{ ai_gen_id }});
  })();
</script>

