          "settings": {
            "question": "How do I contact Genesyx?",
            "answer": "<p>Email us at <a href=\"mailto:info@genesyx.co.uk\">info@genesyx.co.uk</a> or use our <a href=\"/pages/contact\" title=\"Contact Genesyx\">contact form</a>. Genesyx Ltd, Unit 8 Axiom, Orbital Park, Ashford, Kent TN24 0AA.</p>"
          }
        }
