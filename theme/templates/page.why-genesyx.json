        "learn": { "type": "milestone", "settings": { "label": "Learn over time", "title": "Let patterns emerge honestly", "body": "<p>Insights are grounded in what you actually record. When there is not enough information, Genesyx keeps the experience honest rather than filling the space with assumptions.</p>", "image": "shopify://shop_images/genesyx-why-app-learn.jpg", "image_alt": "The Genesyx insights screen on a phone on a desk, showing cycle, symptom and nutrition patterns over time" } },
        "calm": { "type": "principle", "settings": { "title": "Calm over noise", "body": "Clear language and gentle prompts help make daily tracking feel manageable." } },
