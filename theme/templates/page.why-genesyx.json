        "listen": { "type": "milestone", "settings": { "label": "Listen first", "title": "Start with the person, not the metric", "body": "<p>Genesyx begins with a personalised onboarding experience and gives you control over what you track. The aim is useful context without pressure.</p>", "image": "shopify://shop_images/genesyx-why-app-listen.jpg", "image_alt": "The Genesyx home screen showing a personalised tracker list for cycle, hydration, pH, sleep, symptoms and nutrition" } },
