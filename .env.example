# Store handle only — the part before .myshopify.com
SHOPIFY_STORE=trygenesyx

# Admin API access token from a custom app in Shopify admin.
# Settings > Apps and sales channels > Develop apps > your app > API credentials.
# Needs the read_files scope. Starts with shpat_
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Defaults to 2026-07 (latest stable).
# SHOPIFY_API_VERSION=2026-07
