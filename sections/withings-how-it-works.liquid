{%- comment -%} Withings U-Scan Nutrio how-it-works — video + 3 cards {%- endcomment -%}
<section class="wi-scope bg-greige py-20 md:py-28">
  <div class="wi-container">
    <div class="wi-reveal mx-auto max-w-3xl text-center">
      <p class="text-[13px] font-medium uppercase tracking-wide text-ink-soft">{{ section.settings.eyebrow }}</p>
      <h2 class="mt-3 text-[30px] leading-[1.08] tracking-[-0.02em] sm:text-[40px] md:text-[48px]">{{ section.settings.heading }}</h2>
      <p class="mx-auto mt-5 max-w-2xl text-[17px] text-ink-soft">{{ section.settings.body }}</p>
    </div>

    <div class="wi-reveal mt-12" data-reveal-delay="60">
      <a href="{{ section.settings.video_link | default: '#' }}" {% if section.settings.video_link != blank %}target="_blank" rel="noopener"{% endif %} class="group relative block overflow-hidden rounded-2xl">
        {%- assign hiw_poster = 'genesyx-how-poster.png' | asset_url -%}
        {%- if section.settings.poster != blank -%}{%- assign hiw_poster = section.settings.poster | image_url: width: 1600 -%}{%- endif -%}
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: class: 'js-inview-video h-full w-full object-cover', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'none', poster: hiw_poster }}
        {%- else -%}
          <video class="js-inview-video h-full w-full object-cover" muted autoplay loop playsinline preload="none" poster="{{ hiw_poster }}">
            {%- if section.settings.video_url != blank -%}<source src="{{ section.settings.video_url }}">{%- else -%}<source src="{{ 'genesyx-how.mp4' | asset_url }}" type="video/mp4">{%- endif -%}
          </video>
        {%- endif -%}
        <div class="absolute inset-0 bg-black/20"></div>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center text-white">
          <p class="text-[22px] font-medium sm:text-[28px]">{{ section.settings.video_caption }}</p>
        </div>
      </a>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-3">
      {%- for block in section.blocks -%}
        <div class="wi-reveal rounded-2xl bg-card p-8" data-reveal-delay="{{ forloop.index0 | times: 80 }}" {{ block.shopify_attributes }}>
          <p class="text-[13px] font-medium uppercase tracking-wide text-ink-soft">{{ block.settings.eyebrow }}</p>
          <h3 class="mt-3 text-[22px] leading-snug">{{ block.settings.title }}</h3>
          <p class="mt-3 text-[15px] text-ink-soft">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Withings how it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "U-Scan Nutrio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The first toilet plug-in urine scanner" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Your urine holds a wealth of health information through its 3,000 metabolites — insight that usually stays out of reach. U-Scan Nutrio brings that analysis home." },
    { "type": "url", "id": "video_link", "label": "Video link" },
    { "type": "text", "id": "video_caption", "label": "Video caption", "default": "The nutrition revolution has arrived" },
    { "type": "header", "content": "Preview media" },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "video", "id": "video", "label": "Preview video (Shopify files)" },
    { "type": "text", "id": "video_url", "label": "External video URL fallback", "info": "Used only when no Shopify video is selected." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Withings how it works",
      "blocks": [
        { "type": "card", "settings": { "eyebrow": "Advanced nutrition parameters", "title": "Capture key nutritional insights", "body": "Get a clear picture of your body's response to nutrition through four crucial health parameters." } },
        { "type": "card", "settings": { "eyebrow": "Tailored health plan", "title": "Build your personalized nutrition strategy", "body": "Choose a measurement plan that matches your lifestyle and health needs, with access to premium reports." } },
        { "type": "card", "settings": { "eyebrow": "In-depth insights", "title": "Discover how your diet correlates to your body", "body": "See the direct impact of your nutritional intake through precise, objective data and clear correlations." } }
      ]
    }
  ]
}
{% endschema %}
