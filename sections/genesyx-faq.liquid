{%- comment -%}
  Genesyx FAQ: accessible accordion + FAQPage JSON-LD built from the same blocks,
  so the visible answers and the structured data can never drift apart.
{%- endcomment -%}
<section
  id="gxfaq-{{ section.id }}"
  class="gxfaq"
  style="--gxfaq-bg: {{ section.settings.background }}; --gxfaq-text: {{ section.settings.text_color }}; --gxfaq-accent: {{ section.settings.accent }};"
>
  <div class="gxfaq__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="gxfaq__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="gxfaq__title">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="gxfaq__intro">{{ section.settings.intro }}</div>
    {%- endif -%}

    <div class="gxfaq__list">
      {%- for block in section.blocks -%}
        <details class="gxfaq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="gxfaq__question">
            <h2 class="gxfaq__question-text">{{ block.settings.question }}</h2>
            <span class="gxfaq__icon" aria-hidden="true"></span>
          </summary>
          <div class="gxfaq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.disclaimer != blank -%}
      <p class="gxfaq__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "url": {{ canonical_url | json }},
      "publisher": { "@id": {{ request.origin | append: '/#organization' | json }} },
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | strip | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | strip | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .gxfaq {
    background: var(--gxfaq-bg, #fffefb);
    color: var(--gxfaq-text, #252238);
    font-family: "Outfit", var(--font-body-family);
  }

  .gxfaq__inner {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 8rem) 1.6rem;
  }

  .gxfaq__eyebrow {
    margin: 0 0 1rem;
    color: var(--gxfaq-accent, #6650c7);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .gxfaq__title {
    margin: 0;
    color: inherit;
    font-family: inherit;
    font-size: clamp(3.2rem, 5vw, 4.8rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .gxfaq__intro {
    margin-top: 1.6rem;
    font-size: 1.8rem;
    line-height: 1.55;
    opacity: 0.85;
  }

  .gxfaq__intro p { margin: 0 0 1rem; }

  .gxfaq__list {
    margin-top: 4rem;
    border-top: 1px solid rgba(37, 34, 56, 0.12);
  }

  .gxfaq__item {
    border-bottom: 1px solid rgba(37, 34, 56, 0.12);
  }

  .gxfaq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.2rem 0;
    cursor: pointer;
    list-style: none;
  }

  .gxfaq__question::-webkit-details-marker { display: none; }

  .gxfaq__question:focus-visible {
    outline: 2px solid var(--gxfaq-accent, #6650c7);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .gxfaq__question-text {
    margin: 0;
    color: inherit;
    font-family: inherit;
    font-size: 1.9rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .gxfaq__icon {
    position: relative;
    flex: 0 0 2rem;
    width: 2rem;
    height: 2rem;
  }

  .gxfaq__icon::before,
  .gxfaq__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--gxfaq-accent, #6650c7);
    transition: transform 0.2s ease;
  }

  .gxfaq__icon::after { transform: rotate(90deg); }
  .gxfaq__item[open] .gxfaq__icon::after { transform: rotate(0deg); }

  .gxfaq__answer {
    padding: 0 0 2.4rem;
    font-size: 1.7rem;
    line-height: 1.65;
    opacity: 0.9;
  }

  .gxfaq__answer p { margin: 0 0 1.2rem; }
  .gxfaq__answer p:last-child { margin-bottom: 0; }
  .gxfaq__answer a { color: var(--gxfaq-accent, #6650c7); text-underline-offset: 3px; }

  .gxfaq__disclaimer {
    margin: 4rem 0 0;
    font-size: 1.4rem;
    line-height: 1.5;
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .gxfaq__icon::before,
    .gxfaq__icon::after { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Genesyx FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Help centre" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fffefb" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#252238" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#6650c7" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "Genesyx FAQ" }]
}
{% endschema %}
