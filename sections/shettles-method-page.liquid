e-columns:auto 1fr auto;padding:28px;text-decoration:none;transition:transform .2s ease,box-shadow .2s ease}.sm-choice:hover{box-shadow:0 22px 55px rgba(35,31,58,.13);transform:translateY(-3px)}.sm-choice__icon{align-items:center;background:#f0ecff;border-radius:16px;display:flex;height:64px;justify-content:center;width:64px}.sm-choice__icon svg{height:38px;stroke:var(--sm-accent);stroke-linecap:round;stroke-linejoin:round;stroke-width:2;width:38px}.sm-choice strong{display:block;font-size:24px}.sm-choice small{display:block;font-size:14px;line-height:1.5;margin-top:5px;opacity:.72}.sm-arrow{font-size:22px}.sm-section{padding:var(--sm-space) 0}.sm-section--tint{background:#f6f6f2}.sm-section--dark{background:#252238;color:#fff}.sm-reading{max-width:880px}.sm-reading h2,.sm-heading h2{font-size:clamp(34px,4.2vw,56px)}.sm-reading>p:not(.sm-kicker){font-size:18px;margin-top:22px}.sm-heading{margin-bottom:42px;max-width:760px}.sm-heading>p:last-child{font-size:18px;margin-top:16px;opacity:.76}.sm-heading--compact{margin-bottom:24px}.sm-heading--compact h3{font-size:32px}.sm-research-grid{display:grid;gap:20px;grid-template-columns:repeat(2,1fr)}.sm-panel{background:var(--sm-surface);border:1px solid rgba(35,31,58,.1);border-radius:20px;padding:30px}.sm-panel h3{font-size:26px;margin:16px 0 14px}.sm-panel p+p{margin-top:16px}.sm-panel a{color:var(--sm-accent);font-weight:700;text-underline-offset:4px}.sm-number{color:var(--sm-accent);font-size:13px;font-weight:700}.sm-callout{border-left:3px solid var(--sm-accent);font-weight:650;padding-left:14px}.sm-library,.sm-verified{margin-top:64px}.sm-card-grid{display:grid;gap:20px;grid-template-columns:repeat(3,1fr)}.sm-card-grid--two{grid-template-columns:repeat(2,1fr)}.sm-pdf-card{background:var(--sm-surface);border:1px solid rgba(35,31,58,.1);border-radius:20px;display:flex;flex-direction:column;padding:28px;transition:border-color .2s ease,transform .2s ease}.sm-pdf-card:hover{border-color:color-mix(in srgb,var(--sm-accent) 45%,transparent);transform:translateY(-3px)}.sm-pdf-card h3,.sm-pdf-card h4{font-size:22px;margin:16px 0}.sm-pdf-card p{font-size:14px;opacity:.8}.sm-pdf-card p+p{margin-top:14px}.sm-pdf-card--dark{background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.14)}.sm-tag{color:var(--sm-accent);font-size:11px;font-weight:750;letter-spacing:.08em;text-transform:uppercase}.sm-section--dark .sm-tag{color:#c8bbff}.sm-link-group{display:flex;flex-wrap:wrap;gap:10px;margin-top:auto;padding-top:26px}.sm-link-button{align-items:center;border:1px solid currentColor;border-radius:999px;display:inline-flex;font-size:13px;font-weight:750;gap:7px;justify-content:center;line-height:1.2;min-height:42px;padding:10px 15px;text-decoration:none;transition:background .2s ease,color .2s ease,transform .2s ease}.sm-link-button:hover{transform:translateY(-2px)}.sm-link-button--primary{background:var(--sm-accent);border-color:var(--sm-accent);color:#fff!important}.sm-link-button--primary:hover{background:color-mix(in srgb,var(--sm-accent) 86%,#000)}.sm-link-button--light{background:#fff;border-color:#fff;color:#252238!important}.sm-link-button--light:hover{background:#eee9ff;border-color:#eee9ff}.sm-link-button--ghost{background:transparent;border-color:rgba(255,255,255,.42);color:#fff!important}.sm-link-button--ghost:hover{background:rgba(255,255,255,.1);border-color:#fff}.sm-evidence-grid{display:grid;gap:1px;grid-template-columns:repeat(3,1fr)}.sm-evidence-grid article{background:#f2efff;padding:30px}.sm-evidence-grid article:first-child{border-radius:20px 0 0 20px}.sm-evidence-grid article:last-child{border-radius:0 20px 20px 0}.sm-evidence-grid span{color:var(--sm-accent);font-size:12px;font-weight:700;text-transform:uppercase}.sm-evidence-grid h3{font-size:23px;margin:15px 0}.sm-source-list{border-top:1px solid rgba(255,255,255,.18)}.sm-source{display:grid;gap:24px;grid-template-columns:1.15fr .9fr 1.25fr auto;padding:30px 0;border-bottom:1px solid rgba(255,255,255,.18)}.sm-source h4{font-size:20px;margin-top:10px}.sm-source dl{font-size:13px;margin:0}.sm-source dl div+div{margin-top:8px}.sm-source dt{font-weight:700}.sm-source dd{margin:0;opacity:.75}.sm-source>p{font-size:14px;opacity:.78}.sm-source__actions{align-content:center;display:flex;flex-direction:column;gap:8px}.sm-source__actions .sm-link-button{white-space:nowrap}.sm-faq-layout{display:grid;gap:64px;grid-template-columns:.75fr 1.25fr}.sm-faq details{border-top:1px solid rgba(35,31,58,.18);padding:20px 0}.sm-faq details:last-child{border-bottom:1px solid rgba(35,31,58,.18)}.sm-faq summary{align-items:center;cursor:pointer;display:flex;font-size:18px;font-weight:700;justify-content:space-between;list-style:none}.sm-faq summary::-webkit-details-marker{display:none}.sm-faq summary span{font-size:24px;margin-left:16px}.sm-faq details[open] summary span{transform:rotate(45deg)}.sm-faq details p{margin-top:12px;max-width:720px}.sm-footer{background:#171521;color:#fff;padding:34px 0}.sm-footer strong{font-size:14px}.sm-footer p{font-size:13px;margin-top:6px;max-width:980px;opacity:.72}.sm-page :focus-visible{outline:3px solid #ffbf47;outline-offset:4px}
  @media(max-width:900px){.sm-hero__grid,.sm-faq-layout{grid-template-columns:1fr}.sm-choices,.sm-card-grid,.sm-source,.sm-evidence-grid{grid-template-columns:1fr}.sm-source{gap:16px}.sm-evidence-grid article,.sm-evidence-grid article:first-child,.sm-evidence-grid article:last-child{border-radius:16px}.sm-heading--sticky{position:static}}
  @media(max-width:640px){.sm-shell{padding-left:18px;padding-right:18px}.sm-hero{padding-top:58px}.sm-choices,.sm-research-grid,.sm-card-grid--two{grid-template-columns:1fr}.sm-choice{padding:22px}.sm-choice__icon{height:52px;width:52px}.sm-section{padding:64px 0}.sm-panel,.sm-pdf-card{padding:22px}}
  @media(prefers-reduced-motion:reduce){.sm-page *{scroll-behavior:auto!important;transition:none!important}}
</style>

{% schema %}
{
  "name": "Shettles evidence page",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Hero eyebrow","default":"Genesyx evidence library"},
    {"type":"text","id":"hero_title","label":"Hero title","default":"The Shettles Method: Research, Claims and Evidence"},
    {"type":"textarea","id":"hero_text","label":"Hero text","default":"An evidence-based overview of the theory, its historical development, and what published research has found."},
    {"type":"textarea","id":"disclaimer","label":"Hero disclaimer","default":"The Shettles Method is not proven to guarantee or reliably determine the sex of a baby. This page is for educational purposes and is not medical advice."},
