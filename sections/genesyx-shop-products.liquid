{%- comment -%} Homepage shop — product cards with price and add to cart. Replaces the "coming soon" signup.
  Products come from the "Products" picker in the theme editor. Sizing lives in this style block because the
  theme's precompiled Tailwind has no new arbitrary values, and the root font-size is 10px, so px not rem. {%- endcomment -%}
<style>
  #shop .gx-shop-inner { margin-left: auto; margin-right: auto; max-width: 1120px; }
  #shop .gx-shop-copy { margin-left: auto; margin-right: auto; max-width: 680px; text-align: center; }
  #shop .gx-shop-copy p + p { margin-top: 1em; }
  #shop .gx-shop-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; margin-top: 48px; }
  #shop .gx-card { flex: 1 1 260px; max-width: 360px; box-sizing: border-box; display: flex; flex-direction: column; border: 1px solid rgba(41, 37, 34, 0.12); border-radius: 20px; padding: 24px; background: #fff; text-align: center; }
  #shop .gx-card-media { display: block; border-radius: 14px; overflow: hidden; }
  #shop .gx-card-img { display: block; width: 100%; height: 260px; object-fit: contain; }
  #shop .gx-card-title { margin-top: 20px; font-size: 22px; line-height: 1.2; letter-spacing: -0.01em; }
  #shop .gx-card-sub { margin-top: 6px; font-size: 14px; }
  #shop .gx-card-price { margin-top: 12px; font-size: 22px; letter-spacing: -0.01em; }
  #shop .gx-card-price s { margin-left: 8px; font-size: 16px; opacity: 0.6; }
  #shop .gx-card-actions { margin-top: auto; padding-top: 20px; display: flex; flex-direction: column; gap: 10px; }
  #shop .gx-btn { display: block; width: 100%; min-height: 52px; border-radius: 10px; font-size: 16px; font-weight: 500; }
  #shop .gx-btn[disabled] { opacity: 0.5; cursor: not-allowed; }
  #shop .gx-link { font-size: 14px; text-decoration: underline; text-underline-offset: 3px; }
  #shop .gx-trust { margin-top: 32px; }
  @media (min-width: 1024px) {
    #shop .gx-card-img { height: 300px; }
  }
</style>
{%- liquid
  if section.settings.show_all
    assign shop_products = collections.all.products
  else
    assign shop_products = section.settings.products
  endif
  comment
    On a product page, never list the product being viewed. The section hides itself if nothing is left.
  endcomment
  assign current_id = 0
  if template.name == 'product'
    assign current_id = product.id
  endif
  assign shown = 0
  for p in shop_products
    if p.id != current_id
      assign shown = shown | plus: 1
    endif
  endfor
-%}
{%- if shown > 0 -%}
<section id="shop" class="wi-scope scroll-mt-32 bg-background py-20 md:py-28">
  <div class="wi-container">
    <div class="gx-shop-inner">
      <div class="wi-reveal gx-shop-copy">
        {%- if section.settings.badge != blank -%}
          <span class="inline-block rounded-full bg-lilac/30 px-3 py-1 text-[12px] font-medium">{{ section.settings.badge }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="mt-4 text-[28px] leading-[1.08] tracking-[-0.02em] sm:text-[36px] md:text-[42px]">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="mt-4 text-[16px] leading-relaxed text-ink-soft">{{ section.settings.body }}</div>
        {%- endif -%}
      </div>

      <div class="gx-shop-grid">
        {%- for p in shop_products -%}
          {%- if p.id == current_id -%}{%- continue -%}{%- endif -%}
          {%- assign variant = p.selected_or_first_available_variant -%}
          <div class="wi-reveal gx-card" data-reveal-delay="{{ forloop.index0 | times: 80 }}">
            <a href="{{ p.url }}" class="gx-card-media" aria-label="{{ p.title | escape }}">
              {%- if p.featured_image != blank -%}
                <img src="{{ p.featured_image | image_url: width: 700 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" width="700" height="700" loading="lazy" class="gx-card-img">
              {%- endif -%}
            </a>
            <h3 class="gx-card-title"><a href="{{ p.url }}">{{ p.title }}</a></h3>
            {%- if variant.title != 'Default Title' -%}
              <p class="gx-card-sub text-ink-soft">{{ variant.title }}</p>
            {%- endif -%}
            {%- unless p.tags contains 'coming-soon' -%}
            <p class="gx-card-price">
              {{ variant.price | money }}
              {%- if variant.compare_at_price > variant.price -%}<s>{{ variant.compare_at_price | money }}</s>{%- endif -%}
            </p>
            {%- endunless -%}
            <div class="gx-card-actions">
              {%- form 'product', p -%}
                <input type="hidden" name="id" value="{{ variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="gx-btn bg-periwinkle text-white transition hover:bg-periwinkle-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-periwinkle"{% unless variant.available %} disabled{% endunless %}>
                  {%- if variant.available -%}{{ section.settings.button_label }}{%- else -%}{{ section.settings.sold_out_label }}{%- endif -%}
                </button>
              {%- endform -%}
              <a href="{{ p.url }}" class="gx-link text-ink-soft">{{ section.settings.details_label }}</a>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank or section.settings.trust_3 != blank -%}
        <div class="gx-trust flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[13px] text-ink-soft">
          {%- if section.settings.trust_1 != blank -%}
            <span class="inline-flex items-center gap-1.5">{% render 'wi-icon', name: 'check', class: 'h-4 w-4 text-periwinkle' %} {{ section.settings.trust_1 }}</span>
          {%- endif -%}
          {%- if section.settings.trust_2 != blank -%}
            <span class="inline-flex items-center gap-1.5">{% render 'wi-icon', name: 'check', class: 'h-4 w-4 text-periwinkle' %} {{ section.settings.trust_2 }}</span>
          {%- endif -%}
          {%- if section.settings.trust_3 != blank -%}
            <span class="inline-flex items-center gap-1.5">{% render 'wi-icon', name: 'check', class: 'h-4 w-4 text-periwinkle' %} {{ section.settings.trust_3 }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.disclaimer != blank -%}
        <p class="mt-6 text-center text-[12px] leading-relaxed text-ink-soft">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Genesyx shop",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "info": "Leave blank to hide", "default": "Now available" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop Genesyx" },
    { "type": "richtext", "id": "body", "label": "Intro text" },
    { "type": "checkbox", "id": "show_all", "label": "Show all products", "info": "Lists every product in the store, newest included automatically. Overrides the picker below.", "default": false },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to basket" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "details_label", "label": "Details link label", "default": "View details" },
    { "type": "text", "id": "trust_1", "label": "Trust badge 1" },
    { "type": "text", "id": "trust_2", "label": "Trust badge 2" },
    { "type": "text", "id": "trust_3", "label": "Trust badge 3" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer" }
  ],
  "presets": [{ "name": "Genesyx shop" }]
}
{% endschema %}
