{%- comment -%} Withings U-Scan Nutrio footer {%- endcomment -%}
<footer class="wi-scope bg-white text-ink">
  <div class="wi-container py-14">
    {%- comment -%} Country selector {%- endcomment -%}
    <div class="mb-10 flex flex-wrap items-center gap-3">
      <span class="text-[14px] text-ink-soft">{{ section.settings.country_label }}</span>
      <button class="flex items-center gap-2 rounded-md border border-border-soft px-3 py-1.5 text-[14px]">
        {{ section.settings.country_value }}
        {% render 'wi-icon', name: 'chevron-down', class: 'h-3.5 w-3.5' %}
      </button>
    </div>

    {%- comment -%} Link columns {%- endcomment -%}
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-3 lg:grid-cols-6">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h3 class="mb-4 text-[13px] font-medium uppercase tracking-wide text-ink-soft">{{ block.settings.heading }}</h3>
          <ul class="space-y-2.5">
            {%- assign links = block.settings.links | newline_to_br | split: '<br />' -%}
            {%- for l in links -%}
              {%- assign l = l | strip -%}
              {%- if l != blank -%}
                {%- assign parts = l | split: '|' -%}
                {%- assign label = parts[0] | strip -%}
                {%- assign url = parts[1] | strip -%}
                {%- if url != blank and url != '#' -%}
                  <li><a href="{{ url }}" class="text-[14px] text-ink hover:text-ink/60">{{ label }}</a></li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} App badges {%- endcomment -%}
    <div class="mt-12 flex flex-wrap items-center gap-4 border-t border-border-soft pt-8">
      {%- if section.settings.appstore_link != blank -%}
        <a href="{{ section.settings.appstore_link }}" target="_blank" rel="noopener noreferrer" aria-label="Download on the App Store (opens in a new tab)">
          {% render 'wi-image', image: section.settings.appstore_image, fallback: 'app-store.png', alt: 'Download on the App Store', class: 'h-10 w-auto' %}
        </a>
      {%- endif -%}
      {%- if section.settings.googleplay_link != blank -%}
        <a href="{{ section.settings.googleplay_link }}" target="_blank" rel="noopener noreferrer" aria-label="Get it on Google Play (opens in a new tab)">
          {% render 'wi-image', image: section.settings.googleplay_image, fallback: 'google-play.png', alt: 'Get it on Google Play', class: 'h-10 w-auto' %}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Legal bar {%- endcomment -%}
  <div class="border-t border-border-soft">
    <div class="wi-container flex flex-col gap-3 py-6 text-[13px] text-ink-soft md:flex-row md:items-center md:justify-between">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name }}. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {%- assign legal = section.settings.legal_links | newline_to_br | split: '<br />' -%}
        {%- for l in legal -%}
          {%- assign l = l | strip -%}
          {%- if l != blank -%}
            {%- assign parts = l | split: '|' -%}
            {%- assign label = parts[0] | strip -%}
            {%- assign url = parts[1] | strip -%}
            {%- if url != blank and url != '#' -%}
              <li><a href="{{ url }}" class="hover:text-ink">{{ label }}</a></li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Withings footer",
  "settings": [
    { "type": "text", "id": "country_label", "label": "Country label", "default": "Choose your language or country" },
    { "type": "text", "id": "country_value", "label": "Country value", "default": "United Kingdom · GBP" },
    { "type": "text", "id": "copyright_name", "label": "Copyright name", "default": "Withings" },
    { "type": "textarea", "id": "legal_links", "label": "Legal links — one per line, optional format: Label | /url", "default": "Terms & conditions of sale\nTerms of use\nPrivacy policy\nCookie policy\nLegal notice\nAccessibility" },
    { "type": "header", "content": "App store badges" },
    { "type": "image_picker", "id": "appstore_image", "label": "App Store badge" },
    { "type": "url", "id": "appstore_link", "label": "App Store link" },
    { "type": "image_picker", "id": "googleplay_image", "label": "Google Play badge" },
    { "type": "url", "id": "googleplay_link", "label": "Google Play link" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "links", "label": "Links — one per line, optional format: Label | /url" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Withings footer",
      "blocks": [
        { "type": "column", "settings": { "heading": "Urine lab", "links": "U-Scan Nutrio\nU-Scan Calci" } },
        { "type": "column", "settings": { "heading": "Watches", "links": "ScanWatch Nova\nScanWatch Nova Brilliant\nScanWatch 2\nScanWatch Light\nCompare" } },
        { "type": "column", "settings": { "heading": "Scales", "links": "BodyScan 2\nBody Scan\nBodyFit\nBody Comp\nBody Smart\nCompare" } },
        { "type": "column", "settings": { "heading": "Other devices", "links": "BPM Vision\nBPM Connect\nBPM Core\nSleep Analyzer\nBeam O\nHealth mate" } },
        { "type": "column", "settings": { "heading": "Company", "links": "About us\nCareers\nPress\nSustainability\nWithings Health Institute\nAffiliates" } },
        { "type": "column", "settings": { "heading": "Support", "links": "Help centre\nhello@genesyx.co.uk | mailto:hello@genesyx.co.uk\nWarranty\nOrder tracking\nCompatibility\nUser manuals" } }
      ]
    }
  ]
}
{% endschema %}
