{%- comment -%}
  pH-tracking landing — Problem/Value. Three short value props (icon + one-line copy).
  Icons are inlined SVGs from theme assets (zero extra requests, tint via currentColor).
{%- endcomment -%}
<section class="wi-scope bg-background py-16 md:py-24">
  <div class="wi-container">
    {%- if section.settings.heading != blank -%}
      <div class="wi-reveal mx-auto max-w-2xl text-center">
        {%- if section.settings.eyebrow != blank -%}
          <p class="text-[13px] font-medium uppercase tracking-wide text-ink-soft">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="mt-3 text-[28px] leading-[1.08] tracking-[-0.02em] sm:text-[36px] md:text-[40px]">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="mt-12 grid grid-cols-1 gap-4 md:grid-cols-3">
      {%- for block in section.blocks -%}
        <div class="wi-reveal rounded-2xl bg-card p-8" data-reveal-delay="{{ forloop.index0 | times: 80 }}" {{ block.shopify_attributes }}>
          {%- assign icon_file = block.settings.icon | strip | default: 'icon-bottle.svg' -%}
          <span class="phval-icon flex h-12 w-12 items-center justify-center rounded-full bg-mint/40 text-periwinkle">
            {{ icon_file | inline_asset_content }}
          </span>
          <h3 class="mt-5 text-[20px] leading-snug">{{ block.settings.title }}</h3>
          <p class="mt-3 text-[15px] text-ink-soft">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <style>
    .phval-icon svg { width: 22px; height: 22px; }
  </style>
</section>

{% schema %}
{
  "name": "pH landing · Value props",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why pH" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A small signal that says a lot" }
  ],
  "blocks": [
    {
      "type": "prop",
      "name": "Value prop",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (asset filename, .svg)", "info": "e.g. icon-bottle.svg, icon-heart.svg, icon-lightning-bolt.svg", "default": "icon-bottle.svg" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "Body (one line)" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "pH landing · Value props",
      "blocks": [
        { "type": "prop", "settings": { "icon": "icon-bottle.svg", "title": "Hydration, made visible", "body": "pH shifts with how much you drink — see whether today leaned too concentrated or well balanced." } },
        { "type": "prop", "settings": { "icon": "icon-heart.svg", "title": "Balance you can act on", "body": "An optimal 6.0–7.5 window turns a lab metric into a simple daily target you can actually hit." } },
        { "type": "prop", "settings": { "icon": "icon-lightning-bolt.svg", "title": "Patterns over time", "body": "One reading is a snapshot; 30 days is a trend — spot what your diet and hydration really do." } }
      ]
    }
  ]
}
{% endschema %}
