{%- comment -%} Withings U-Scan Nutrio newsletter — Shopify customer form {%- endcomment -%}
<section class="wi-scope bg-greige py-20 md:py-24">
  <div class="wi-container">
    <div class="wi-reveal mx-auto max-w-xl text-center">
      <h2 class="text-[28px] leading-[1.08] tracking-[-0.02em] sm:text-[36px]">{{ section.settings.heading }}</h2>
      <p class="mt-4 text-[16px] text-ink-soft">{{ section.settings.body }}</p>

      {%- form 'customer', class: 'mx-auto mt-8 flex max-w-md flex-col gap-3 sm:flex-row' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="w-full text-[14px] font-medium text-ink">{{ 'newsletter.success' | t | default: 'Thanks for subscribing.' }}</p>
        {%- else -%}
          <input type="email" name="contact[email]" required placeholder="{{ section.settings.placeholder }}"
            class="h-12 flex-1 rounded-lg border border-border-soft bg-card px-4 text-[15px] outline-none focus:border-ink">
          <button type="submit" class="h-12 rounded-lg bg-periwinkle px-6 text-[15px] font-medium text-white transition hover:bg-periwinkle-hover">
            {{ section.settings.button_label }}
          </button>
        {%- endif -%}
      {%- endform -%}

      <p class="mt-4 text-[12px] text-ink-soft">{{ section.settings.finetext }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Withings newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start your health journey" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Sign up to discover the entire Withings ecosystem, our latest products, and exclusive offers." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Register" },
    { "type": "textarea", "id": "finetext", "label": "Fine print", "default": "By registering, you agree to receive marketing e-mails from Withings. You can unsubscribe at any time." }
  ],
  "presets": [{ "name": "Withings newsletter" }]
}
{% endschema %}
